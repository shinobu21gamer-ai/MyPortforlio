---
interface Project {
  title: string;
  tag: string;
  summary: string;
  stack: string[];
  github: string;
  preview: string;
  status: "Live" | "In progress";
  stat: { value: string; label: string };
}

const projects: Project[] = [
  {
    title: "HRMS / POS System",
    tag: "Backend-heavy",
    summary:
      "Full HRIS + point-of-sale for a growing team — payroll, inventory, sales reports, and role-based access in one deploy.",
    stack: ["Next.js", "Node.js", "MySQL", "Prisma"],
    github: "https://github.com/shinobu21gamer-ai/Portforlio",
    preview: "https://portforlio-1cqq.onrender.com/hrms/",
    status: "Live",
    stat: { value: "4+", label: "modules" },
  },
  {
    title: "Barangay Resolve",
    tag: "Community platform",
    summary:
      "Web + Android app for local dispute resolution — residents file concerns, officials track them, and push alerts keep everyone in the loop.",
    stack: ["Next.js", "Capacitor", "Firebase", "FCM"],
    github: "https://github.com/shinobu21gamer-ai/app.building",
    preview: "https://barangayresolve.vercel.app/",
    status: "In progress",
    stat: { value: "24/7", label: "alerts" },
  },
];
---

<section id="projects" class="relative border-t border-[var(--line)]">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:px-10">
    <header class="reveal mb-14">
      <p class="mb-3 font-mono text-xs tracking-[0.22em] uppercase text-[var(--acid)]">
        // selected work
      </p>
      <h2 class="text-4xl font-semibold tracking-tight text-[var(--ink)] sm:text-5xl">
        Things I've built
      </h2>
      <p class="mt-4 max-w-lg text-lg text-[var(--ink-dim)]">
        Two systems, both live, both still growing. Click through — the code
        is public.
      </p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {
        projects.map((project) => (
          <article class="reveal group relative flex flex-col overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--panel)] transition-all duration-500 hover:-translate-y-1.5 hover:border-[var(--acid)]/40 hover:shadow-[0_24px_60px_-24px_rgba(200,255,77,0.18)]">
            {/* Cover: generative, not a grey placeholder box */}
            <a
              href={project.preview}
              target="_blank"
              rel="noopener noreferrer"
              class="relative block aspect-[16/9] overflow-hidden"
              aria-label={`Open ${project.title} live preview`}
            >
              <div
                class="absolute inset-0 transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                style={`background:
                  radial-gradient(circle at 82% 18%, rgba(200,255,77,0.14) 0%, transparent 46%),
                  linear-gradient(135deg, #151517 0%, #0c0c0e 100%)`}
              >
                {/* Blueprint grid */}
                <div
                  class="absolute inset-0 opacity-[0.13]"
                  style="background-image: linear-gradient(rgba(244,244,242,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(244,244,242,0.5) 1px, transparent 1px); background-size: 28px 28px;"
                />
                {/* Monogram */}
                <span class="absolute bottom-4 left-5 font-mono text-[10px] tracking-[0.3em] uppercase text-[var(--ink-faint)]">
                  {project.tag}
                </span>
                <span class="absolute right-5 top-4 font-mono text-5xl font-bold text-[var(--acid)] opacity-25 transition-opacity duration-500 group-hover:opacity-60">
                  {project.title.charAt(0)}
                </span>
              </div>
              <span class="absolute right-4 top-4 rounded-full border border-[var(--line)] bg-[var(--bg)]/80 px-3 py-1 font-mono text-[10px] tracking-widest uppercase backdrop-blur-sm"
                class:list={[
                  project.status === "Live"
                    ? "text-[var(--acid)] border-[var(--acid)]/30"
                    : "text-[var(--ink-dim)]",
                ]}
              >
                ● {project.status}
              </span>
            </a>

            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <h3 class="text-2xl font-semibold tracking-tight text-[var(--ink)] transition-colors group-hover:text-[var(--acid)]">
                {project.title}
              </h3>
              <p class="mt-3 flex-1 leading-relaxed text-[var(--ink-dim)]">
                {project.summary}
              </p>

              <ul class="mt-5 flex flex-wrap gap-2">
                {project.stack.map((chip) => (
                  <li class="rounded-full border border-[var(--line)] px-3 py-1 font-mono text-[11px] text-[var(--ink-dim)]">
                    {chip}
                  </li>
                ))}
              </ul>

              <div class="mt-6 flex items-center justify-between border-t border-[var(--line)] pt-5">
                <div>
                  <div class="text-xl font-semibold text-[var(--ink)]">
                    {project.stat.value}
                  </div>
                  <div class="font-mono text-[10px] uppercase tracking-widest text-[var(--ink-faint)]">
                    {project.stat.label}
                  </div>
                </div>
                <div class="flex gap-2">
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.title} source code on GitHub`}
                    class="flex size-11 items-center justify-center rounded-full border border-[var(--line)] text-[var(--ink-dim)] transition-all duration-300 hover:border-[var(--acid)]/50 hover:text-[var(--acid)]"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                      <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z" />
                    </svg>
                  </a>
                  <a
                    href={project.preview}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open ${project.title} live`}
                    class="flex size-11 items-center justify-center rounded-full border border-[var(--line)] text-[var(--ink-dim)] transition-all duration-300 hover:border-[var(--acid)]/50 hover:text-[var(--acid)]"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                      <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="reveal mt-10 text-center">
      <a
        href="mailto:shinobu21gamer@gmail.com?subject=Project%20idea"
        class="group inline-flex items-center gap-2 font-mono text-sm text-[var(--ink-dim)] transition-colors hover:text-[var(--acid)]"
      >
        <span>have something weirder in mind?</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-1">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
        <span>tell me</span>
      </a>
    </div>
  </div>
</section>
