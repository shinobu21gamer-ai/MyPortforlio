---
const email = "shinobu21gamer@gmail.com";
const subject = encodeURIComponent("Let's talk — saw your portfolio");
const body = encodeURIComponent("Hi Ian,\n\n");
const mailto = `mailto:${email}?subject=${subject}&body=${body}`;
---

<section id="contact" class="relative border-t border-[var(--line)]">
  <div class="mx-auto max-w-6xl px-6 py-24 sm:px-10">
    <div class="grid gap-14 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
      <div class="reveal">
        <p class="mb-3 font-mono text-xs tracking-[0.22em] uppercase text-[var(--acid)]">
          // say hi
        </p>
        <h2 class="text-4xl font-semibold tracking-tight text-[var(--ink)] sm:text-5xl">
          Let's make something
          <span class="text-[var(--acid)]">worth shipping</span>
        </h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-[var(--ink-dim)]">
          Recruiters, founders, and the curious — my inbox is open. I reply
          within a day, usually faster. No forms, no tracking pixels, just
          your mail client.
        </p>

        <ul class="mt-10 space-y-5">
          <li class="flex items-center gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-full border border-[var(--line)] text-[var(--ink-dim)]">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d="m18.73 5.41-1.28 1L12 10.46 6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"/>
              </svg>
            </span>
            <div>
              <div class="font-mono text-[10px] uppercase tracking-widest text-[var(--ink-faint)]">Email</div>
              <a href={mailto} class="text-[var(--ink)] transition-colors hover:text-[var(--acid)]">
                {email}
              </a>
            </div>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-full border border-[var(--line)] text-[var(--ink-dim)]">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
              </svg>
            </span>
            <div>
              <div class="font-mono text-[10px] uppercase tracking-widest text-[var(--ink-faint)]">Location</div>
              <span class="text-[var(--ink)]">Trece Martires, Cavite, PH</span>
            </div>
          </li>
          <li class="flex items-center gap-4">
            <span class="flex size-11 shrink-0 items-center justify-center rounded-full border border-[var(--line)] text-[var(--ink-dim)]">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>
              </svg>
            </span>
            <div>
              <div class="font-mono text-[10px] uppercase tracking-widest text-[var(--ink-faint)]">Response time</div>
              <span class="text-[var(--ink)]">Usually under 24 hours</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- Big mailto CTA card -->
      <div class="reveal" style="transition-delay: 140ms">
        <div class="relative flex h-full flex-col justify-between overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--panel)] p-8 sm:p-10">
          <div
            class="pointer-events-none absolute inset-0 opacity-60"
            style="background: radial-gradient(circle at 88% 8%, rgba(200,255,77,0.12) 0%, transparent 42%)"
          />
          <div class="relative">
            <p class="font-mono text-[11px] tracking-[0.18em] uppercase text-[var(--ink-faint)]">
              Fastest way to reach me
            </p>
            <p class="mt-4 text-xl leading-snug text-[var(--ink)]">
              One click. Your mail app opens with the subject line
              <em class="text-[var(--acid)] not-italic">already written</em> —
              you just type the body.
            </p>
          </div>
          <div class="relative mt-10 space-y-3">
            <a
              href={mailto}
              class="group flex w-full items-center justify-center gap-3 rounded-full bg-[var(--acid)] px-8 py-4 text-sm font-semibold text-[var(--bg)] transition-all duration-300 hover:brightness-110 hover:shadow-[0_0_40px_rgba(200,255,77,0.3)]"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="17" height="17" fill="currentColor" class="transition-transform duration-300 group-hover:-rotate-12">
                <path d="m18.73 5.41-1.28 1L12 10.46 6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"/>
              </svg>
              Open mail app
            </a>
            <a
              href={mailto}
              class="block rounded-full border border-[var(--line)] px-8 py-3.5 text-center font-mono text-xs text-[var(--ink-dim)] transition-colors duration-300 hover:border-[var(--acid)]/50 hover:text-[var(--acid)]"
            >
              {email}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
