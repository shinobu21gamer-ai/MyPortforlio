---
const currentYear = new Date().getFullYear();
const email = "shinobu21gamer@gmail.com";
---

<footer class="border-t border-[var(--line)]">
  <div class="mx-auto max-w-6xl px-6 py-14 sm:px-10">
    <div class="flex flex-col items-start justify-between gap-10 md:flex-row md:items-center">
      <div>
        <p class="text-lg font-semibold tracking-tight text-[var(--ink)]">
          Ian Rhod Venerable
        </p>
        <p class="mt-1 font-mono text-[11px] tracking-[0.16em] uppercase text-[var(--ink-faint)]">
          Web & mobile developer — Cavite, PH
        </p>
      </div>

      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-8 gap-y-3">
          <li>
            <a href="#home" data-nav class="font-mono text-xs text-[var(--ink-dim)] uppercase tracking-widest transition-colors hover:text-[var(--acid)]">
              Top
            </a>
          </li>
          <li>
            <a href="#projects" data-nav class="font-mono text-xs text-[var(--ink-dim)] uppercase tracking-widest transition-colors hover:text-[var(--acid)]">
              Work
            </a>
          </li>
          <li>
            <a href={`mailto:${email}`} class="font-mono text-xs text-[var(--ink-dim)] uppercase tracking-widest transition-colors hover:text-[var(--acid)]">
              Email
            </a>
          </li>
          <li>
            <a href="https://github.com/shinobu21gamer-ai" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-[var(--ink-dim)] uppercase tracking-widest transition-colors hover:text-[var(--acid)]">
              GitHub
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-[var(--line)] pt-6 sm:flex-row sm:items-center">
      <p class="font-mono text-[11px] text-[var(--ink-faint)]">
        © {currentYear} Ian Rhod Venerable. Built by hand — Astro, Tailwind, too much coffee.
      </p>
      <a
        href="#home"
        data-nav
        class="group inline-flex items-center gap-2 font-mono text-[11px] text-[var(--ink-faint)] uppercase tracking-widest transition-colors hover:text-[var(--acid)]"
      >
        back to top
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:-translate-y-0.5">
          <path d="M12 19V5M5 11l7-7 7 7"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
