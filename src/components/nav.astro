---
interface NavItem {
  label: string;
  href: string;
}

const navItems: NavItem[] = [
  { label: "Home", href: "#home" },
  { label: "Work", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<div class="pointer-events-none fixed inset-x-0 bottom-5 z-[100] flex justify-center md:bottom-8 md:top-8 md:bottom-auto">
  <nav
    id="main-nav"
    class="pointer-events-auto border border-[var(--line)] bg-[var(--panel)]/70 backdrop-blur-xl transition-[border-color,box-shadow] duration-500 ease-out md:w-auto"
  >
    <ul class="flex items-center gap-1 p-1.5 md:gap-2">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav
              class="nav-link group relative flex items-center gap-2 rounded-full px-4 py-2 font-mono text-[11px] tracking-[0.14em] uppercase text-[var(--ink-dim)] transition-colors duration-300 hover:text-[var(--ink)] md:px-5 md:py-2.5 md:text-xs"
            >
              <span class="nav-dot absolute left-0 top-1/2 h-1 w-1 -translate-y-1/2 rounded-full bg-[var(--acid)] opacity-0 transition-all duration-300 group-hover:opacity-60 md:-left-2" />
              <span class="nav-label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  nav.scrolling {
    border-color: rgba(244, 244, 242, 0.14);
    box-shadow: 0 18px 50px -18px rgba(0, 0, 0, 0.85);
  }

  nav a.active {
    color: var(--ink);
  }
  nav a.active .nav-dot {
    opacity: 1;
  }
  nav a.active .nav-label {
    text-shadow: 0 0 18px rgba(200, 255, 77, 0.35);
  }

  @media (max-width: 767px) {
    nav {
      width: min(92vw, 420px);
    }
    body {
      padding-bottom: 4.5rem;
    }
  }
</style>

<script>
  const nav = document.getElementById("main-nav");

  // Pill contracts as you scroll — cinematic, and it never covers content.
  let ticking = false;
  function updateNav() {
    nav?.classList.toggle("scrolling", window.scrollY > 24);
    ticking = false;
  }
  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateNav);
      }
    },
    { passive: true },
  );

  // Smooth anchor jumps.
  document.querySelectorAll('a[data-nav]').forEach((anchor) => {
    anchor.addEventListener("click", (e) => {
      e.preventDefault();
      const id = (anchor as HTMLAnchorElement).getAttribute("href")?.slice(1);
      const target = id && document.getElementById(id);
      (target as HTMLElement).scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });

  // Active section highlight.
  const sections = document.querySelectorAll("section[id]");
  const links = document.querySelectorAll("nav a[data-nav]");
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.getAttribute("id");
        links.forEach((link) => {
          link.classList.toggle(
            "active",
            link.getAttribute("href") === `#${id}`,
          );
        });
      });
    },
    { rootMargin: "-45% 0px -45% 0px" },
  );
  sections.forEach((section) => io.observe(section));

  // Reveal-on-scroll, cheap and dependency-free.
  const revealTargets = document.querySelectorAll(".reveal");

  // Safety net: if the observer never fires (unsupported, or a headless
  // viewport that reports zero height) reveal everything rather than leave
  // the page blank.
  const revealAll = () =>
    revealTargets.forEach((el) => el.classList.add("is-in"));
  setTimeout(() => {
    if (!document.querySelector(".reveal:not(.is-in)")) return;
    const anyVisible = [...revealTargets].some((el) => {
      const r = el.getBoundingClientRect();
      return r.top < window.innerHeight && r.bottom > 0;
    });
    if (!anyVisible && window.innerHeight === 0) revealAll();
  }, 1200);

  if (!("IntersectionObserver" in window)) {
    revealAll();
  } else {
    const revealIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            revealIO.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );
    revealTargets.forEach((el) => revealIO.observe(el));
  }
</script>
